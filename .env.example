# Environment
APP_ENV=production
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL container published on host port 5433)
DATABASE_URL=postgresql+psycopg://revenue_user:revenue_password@localhost:5433/revenue_ai

# MLOps & Experiment Tracking (MLflow container published on host port 5001)
MLFLOW_TRACKING_URI=http://localhost:5001

# Model Serving
MODEL_NAME=ChurnPredictor
MODEL_VERSION=latest

# LLM Retention Intelligence (Groq + LangChain)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=openai/gpt-oss-120b